<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Visibilidad de paquetes: apps usadas por los accesos + apps lanzables (necesario para un launcher) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.waze" />
        <package android:name="sinet.startup.inDriver" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.whatsapp" />
        <package android:name="com.sec.android.gallery3d" />
        <package android:name="com.google.android.apps.photos" />
        <package android:name="com.sec.android.app.camera" />
        <package android:name="com.android.camera" />
        <package android:name="com.sec.android.app.myfiles" />
        <package android:name="com.google.android.documentsui" />
        <package android:name="com.google.android.apps.nbu.files" />
        <package android:name="com.sec.android.app.popupcalculator" />
        <package android:name="com.google.android.calculator" />
        <package android:name="com.android.vending" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Crossfox">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Solo funciona si el usuario lo autoriza en Ajustes de Android -->
        <service
            android:name=".CrossfoxListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
